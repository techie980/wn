   "source": [
    "import numpy as np\n",
    "# Create an 1-D array\n",
    "arr = np.array([10, 20, 30, 40, 50])\n",
    "print(\"Original Array:\", arr)\n",
    "# Reverse the array \n",
    "rev = arr[::-1]\n",
    "\n",
    "print(\"Reversed Array:\", rev)"
   ]
